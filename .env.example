# ============================================
# DocuMind-Agent Environment Configuration
# ============================================
# Copy this file to .env and configure your settings

# ============================================
# OLLAMA CONFIGURATION
# ============================================
# Ollama API endpoint
OLLAMA_BASE_URL=http://localhost:11434

# Default models for different tasks
OLLAMA_GRADER_MODEL=phi3:mini
OLLAMA_GENERATOR_MODEL=llama3.1:8b
OLLAMA_REWRITER_MODEL=mistral:7b

# ============================================
# VECTOR STORE CONFIGURATION
# ============================================
# ChromaDB persistence directory
CHROMA_PERSIST_DIR=data/vector_store/chroma

# Default collection name
CHROMA_DEFAULT_COLLECTION=documents

# ChromaDB host (for client-server mode)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ============================================
# EMBEDDING MODEL CONFIGURATION
# ============================================
# Embedding model type (MPNET, MULTILINGUAL_MINILM, E5_SMALL, E5_LARGE)
EMBEDDING_MODEL_TYPE=MPNET

# Model cache directory
EMBEDDING_CACHE_DIR=models/cache

# Device for embeddings (cpu, cuda, mps)
EMBEDDING_DEVICE=cpu

# ============================================
# AGENT CONFIGURATION
# ============================================
# Maximum rewrite iterations
MAX_ITERATIONS=3

# Minimum similarity threshold for retrieval
SEARCH_THRESHOLD=0.7

# Grader confidence threshold
GRADER_CONFIDENCE_THRESHOLD=0.6

# Number of documents to retrieve
RETRIEVAL_TOP_K=5

# Enable external tools
ENABLE_TOOLS=true

# ============================================
# DOCUMENT PROCESSING
# ============================================
# Text chunking configuration
CHUNK_SIZE=400
CHUNK_OVERLAP=50
CHUNKING_STRATEGY=recursive

# PDF loader type (auto, pymupdf, pypdf)
PDF_LOADER_TYPE=auto

# Maximum file size in MB
MAX_FILE_SIZE_MB=50

# ============================================
# STREAMLIT APP CONFIGURATION
# ============================================
# App title
APP_TITLE=DocuMind

# Theme (light, dark)
APP_THEME=light

# Layout (wide, centered)
APP_LAYOUT=wide

# ============================================
# LOGGING CONFIGURATION
# ============================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path (empty for stdout only)
LOG_FILE=

# Log format
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ============================================
# DEVELOPMENT & TESTING
# ============================================
# Enable debug mode
DEBUG=false

# Test collection name
TEST_COLLECTION_NAME=test_collection

# Test persist directory
TEST_PERSIST_DIR=tests/data/vector_store/chroma

# ============================================
# PERFORMANCE & CACHING
# ============================================
# Enable query caching
ENABLE_QUERY_CACHE=true

# Cache size
CACHE_SIZE=100

# Batch size for document processing
BATCH_SIZE=100

# ============================================
# SECURITY (if deploying publicly)
# ============================================
# API key for restricted access (optional)
API_KEY=

# Enable authentication
ENABLE_AUTH=false

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
